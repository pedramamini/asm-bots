# Cache-Control for the static files the Worker never sees (`run_worker_first` in
# apps/api/wrangler.jsonc): Workers Static Assets reads this file at deploy and serves no copy of
# it. The build names each file under /assets by its content hash, so a browser keeps it a year
# and never asks again; the pictures keep their names, so a day. Pages and the API are the
# Worker's, and set their own. `scripts/check-bundle.ts` holds the build to these rules.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/docs-shots/*
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
# The docs for AI agents (scripts/agent-docs.ts): any site may fetch them, and they keep their
# names across deploys, so an hour. Their types come from the extension: `.md` is
# text/markdown, `.txt` text/plain, both utf-8. No Content-Type here: a missing `.md` falls back
# to the app's HTML, which must not claim to be Markdown.
/llms.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/llms-full.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/docs/*.md
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/skill/SKILL.md
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
/skill/asm-bots.zip
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
