// The one Worker: the web app's static assets plus the API (ARCHITECTURE §7).
// The D1 and KV ids are placeholders that work for `wrangler dev` (local storage); the deploy
// playbook (3.4) creates the real resources and fills them in.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "asmbots",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // Production domain: a Workers Custom Domain on the asmbots.io zone (same Cloudflare account).
  "routes": [{ "pattern": "asmbots.io", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, a navigation to /api/... would get the SPA's index.html.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asmbots",
      "database_id": "5c8bd9ee-3bb7-4eea-8bfe-dee862bee2e3",
      "remote": true,
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "REPLAYS", "bucket_name": "asmbots-replays" }],
  "kv_namespaces": [{ "binding": "KV", "id": "24af2453a5994d24ace5f8f0900f04ca" }],
  "durable_objects": {
    "bindings": [
      { "name": "RUNNER", "class_name": "Runner" },
      { "name": "LIVE_ROOM", "class_name": "LiveRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Runner", "LiveRoom"] }],
  // A data point per match a Runner plays: count, duration, bots, kind (src/analytics.ts).
  "analytics_engine_datasets": [{ "binding": "MATCH_ANALYTICS", "dataset": "asmbots_matches" }],
  "triggers": {
    // Saturdays 18:00 UTC: the weekly championship.
    "crons": ["0 18 * * 6"]
  },
  "vars": {
    "ISA_VERSION": "x16c-v1",
    // The build stamps the real one: `wrangler deploy --var APP_VERSION:<bun run version>`.
    "APP_VERSION": "dev",
    // The one cross-origin caller: the Vite dev server. The deployed app is same-origin.
    "APP_ORIGIN": "http://localhost:5173",
    // Who may read GET /api/admin/stats: handles, comma-separated. Empty: nobody.
    "ADMIN_HANDLES": ""
  },
  "observability": { "enabled": true },
  // The web app's Vite dev server proxies `/api` here.
  "dev": { "port": 8787 }
}
