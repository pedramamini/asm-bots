// The one Worker: the web app's static assets plus the API (ARCHITECTURE §7).
// The D1 and KV ids are placeholders that work for `wrangler dev` (local storage); the deploy
// playbook (3.4) creates the real resources and fills them in.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "asmbots",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // The share cards' font (src/og/fonts): a `.ttf` import is its bytes, an ArrayBuffer.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  // Production domain: a Workers Custom Domain on the asmbots.io zone (same Cloudflare account).
  "routes": [{ "pattern": "asmbots.io", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker first for everything but the build's hashed files and pictures, and the docs for
    // AI agents (apps/web/scripts/agent-docs.ts): /api/..., and each page, so it can write the
    // page's own head for link previews (src/site/), and /sitemap.xml.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/docs-shots/*",
      "!/favicon.svg",
      "!/llms.txt",
      "!/llms-full.txt",
      "!/docs/*.md",
      "!/skill/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asmbots",
      "database_id": "5c8bd9ee-3bb7-4eea-8bfe-dee862bee2e3",
      // Not `remote`: `wrangler dev` and the API tests keep to local D1; deploys bind this id, and
      // `--remote` on a d1 command reaches it.
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "REPLAYS", "bucket_name": "asmbots-replays" }],
  "kv_namespaces": [{ "binding": "KV", "id": "24af2453a5994d24ace5f8f0900f04ca" }],
  "durable_objects": {
    "bindings": [
      { "name": "RUNNER", "class_name": "Runner" },
      { "name": "LIVE_ROOM", "class_name": "LiveRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Runner", "LiveRoom"] }],
  // A data point per match a Runner plays: count, duration, bots, kind (src/analytics.ts).
  "analytics_engine_datasets": [{ "binding": "MATCH_ANALYTICS", "dataset": "asmbots_matches" }],
  // The running version's id and upload time: /api/health's uptime counts from it.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": {
    // Saturdays 18:00 UTC: the weekly championship.
    "crons": ["0 18 * * 6"]
  },
  "vars": {
    "ISA_VERSION": "x16c-v1",
    // The canonical origin page heads and share cards name (the web build's SITE_URL agrees).
    "SITE_URL": "https://asmbots.io",
    // The build stamps the real one: `wrangler deploy --var APP_VERSION:<bun run version>`.
    "APP_VERSION": "dev",
    // The one cross-origin caller: the Vite dev server. The deployed app is same-origin.
    "APP_ORIGIN": "http://localhost:5173",
    // Who may read GET /api/admin/stats: handles, comma-separated. Empty: nobody.
    "ADMIN_HANDLES": ""
  },
  "observability": { "enabled": true },
  // The web app's Vite dev server proxies `/api` here.
  "dev": { "port": 8787 }
}
