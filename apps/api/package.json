{
  "name": "@asmbots/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && wrangler deploy --dry-run --outdir dist/worker",
    "dev": "mkdir -p ../web/dist && wrangler dev",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply asmbots --local",
    "migrate:remote": "wrangler d1 migrations apply asmbots --remote",
    "seed:local": "bun run scripts/seed.ts --local",
    "seed:remote": "bun run scripts/seed.ts --remote"
  },
  "dependencies": {
    "@asmbots/asm": "workspace:*",
    "@asmbots/engine": "workspace:*",
    "@asmbots/protocol": "workspace:*",
    "@asmbots/tourney": "workspace:*",
    "@asmbots/ui": "workspace:*",
    "arctic": "3.7.0",
    "hono": "4.13.9"
  },
  "devDependencies": {
    "@asmbots/bots": "workspace:*",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260924.1",
    "saxes": "6.0.0",
    "vitest": "4.1.11",
    "wrangler": "4.137.0"
  }
}
